# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# URL frontend untuk konfigurasi CORS
FRONTEND_URL=http://localhost:3000

# ─── Database MySQL (XAMPP) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_inclusive_ed
DB_CONNECTION_LIMIT=10

# ─── Session ──────────────────────────────────────────────────────────────────
# WAJIB diisi dengan string acak yang panjang dan rahasia, misal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=ganti_dengan_string_rahasia_minimal_32_karakter

# Nama cookie session (opsional)
SESSION_NAME=smartinclusive.sid

# Durasi sesi dalam milidetik: default 86400000 = 24 jam (opsional)
SESSION_MAX_AGE=86400000
